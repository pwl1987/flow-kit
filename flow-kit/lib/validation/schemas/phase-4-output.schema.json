{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flow-kit.dev/schemas/phase-4-output.schema.json",
  "title": "Phase 4 Output Schema",
  "description": "开发执行产物验证 schema — v2.9.0 新增",
  "type": "object",
  "required": [
    "change_id",
    "tasks_completed",
    "created_at"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "description": "关联的变更 ID"
    },
    "tasks_completed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DONE",
              "PARTIAL",
              "BLOCKED"
            ]
          },
          "files_modified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests_passed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "已完成任务列表"
    },
    "files_modified": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "所有修改的文件列表"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "阻塞项列表"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
