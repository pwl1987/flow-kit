{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flow-kit.dev/schemas/phase-6-output.schema.json",
  "title": "Phase 6 Output Schema",
  "description": "代码审查产物验证 schema — v2.9.0 新增",
  "type": "object",
  "required": [
    "change_id",
    "review_result",
    "created_at"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "description": "关联的变更 ID"
    },
    "review_result": {
      "type": "string",
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED",
        "REJECTED"
      ],
      "description": "审查结论"
    },
    "issues_found": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      },
      "description": "发现的问题列表"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "审查者列表"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
