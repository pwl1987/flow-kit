{
  "name": "flow-kit",
  "version": "2.5.1",
  "description": "面向 Claude Code 的结构化开发流程工具包，提供 8 阶段开发工作流、护栏规则、子代理调度",
  "author": {
    "name": "pwl1987",
    "url": "https://github.com/pwl1987"
  },
  "repository": "https://github.com/pwl1987/flow-kit",
  "license": "MIT",
  "keywords": ["workflow", "devops", "cli", "development"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-quality-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notification.sh"
          }
        ]
      }
    ]
  },
  "interface": {
    "displayName": "flow-kit",
    "shortDescription": "8 阶段开发流程、护栏规则、子代理调度",
    "category": "Developer Tools",
    "capabilities": ["Interactive", "Write"]
  }
}
